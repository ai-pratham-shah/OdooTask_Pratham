<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add fields to product form view -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.availability</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group name="out_of_stock" string="Availability on Website">
                    <field name="is_out_of_stock"/>
                    <field name="out_of_stock_message" invisible="is_out_of_stock == False"
                    groups="sales_team.group_sale_manager,website.group_website_designer"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add out-of-stock filter in product search view -->
    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit.availability</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter string="Out of Stock" name="filter_out_of_stock" domain="[('is_out_of_stock', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>