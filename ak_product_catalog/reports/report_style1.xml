<odoo>
    <template id="report_product_catalog_style1_document">
        <t t-call="web.html_container">
            <!-- Custom header -->
            <div class="header">
                <h2 style="text-align: center; font-weight: bold; color: #330000;">Generated Product Catalog</h2>
            </div>

            <div class="page">
                <div class="container">
                    <t t-set="product_count" t-value="0"/>
                    <t t-foreach="docs.product_ids" t-as="product">
                        <t t-set="product_count" t-value="product_count + 1"/>

                        <div class="row" style="margin-bottom: 5px;">
                            <!-- Product Image -->
                            <div class="col-3" style="padding-right: 100px; max-width: 25%;">
                                <img t-if="product.image_1920" t-att-src="image_data_uri(product.image_1920)"
                                     style="width: 70%; height: auto; border-radius: 5px;"/>
                                <img t-else="" src="/web/static/img/placeholder.png"
                                     style="width: 100%; height: auto; border-radius: 5px;"/>
                                <!-- Product Details -->
                                <div class="col-3" style="padding-left: 170px; max-width: 75%;">
                                    <!-- Product Name -->
                                    <div>
                                        <span style="font-weight: bold; font-size: 18px; color: #000;">
                                            <t t-esc="product.name"/>
                                        </span>
                                    </div>
                                    <!-- Internal Reference -->
                                    <div style="background-color: #e6e6e6; color: #333; padding: 3px 8px;
                                                display: inline-block; margin: 5px 0; font-weight: bold;">
                                        <t t-esc="product.default_code or '—'"/>
                                    </div>
                                    <!-- Price -->
                                    <div style="margin-bottom: 5px; background-color: #e6e6e6; color: #333; padding: 3px 8px;
                                                display: inline-block; margin: 5px 0; font-weight: bold;">
                                        <span style="color: #000;">Price :
                                            <t t-esc="product.list_price"
                                               t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                        </span>
                                    </div>
                                    <!-- Description -->
                                    <div style="font-size: 13px; color: #555;">
                                        <t t-if="product.description_sale" t-esc="product.description_sale"/>
                                        <t t-elif="product.description" t-esc="product.description"/>
                                        <t t-else="">No description available</t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Separator Line -->
                        <t t-if="product_count != len(docs.product_ids)">
                            <div style="border-top: 2px solid #800040; margin: 10px 0;"></div>
                        </t>
                        <!-- Page Break -->
                        <t t-if="product_count % docs.page_break_after == 0 and product_count != len(docs.product_ids)">
                            <div style="page-break-after: always;"></div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>

