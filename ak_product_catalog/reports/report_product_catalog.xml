    <record id="report_product_catalog_style1_action" model="ir.actions.report">
        <field name="name">Product Catalog Style 1</field>
        <field name="model">product.catalog.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_product_catalog.report_product_catalog_style1_template</field>
