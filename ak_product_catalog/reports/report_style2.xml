<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_product_catalog_style2_document">
        <t t-call="web.html_container">
            <!-- No header or footer for Style 2 -->
            <div class="page">
                <div class="container-fluid p-0">
                    <div class="row">
                        <!-- For Style 2, arrange products in a grid, 4 per page -->
                        <t t-set="product_count" t-value="0"/>
                        <t t-foreach="docs.product_ids" t-as="product">
                            <!-- Increment product counter -->
                            <t t-set="product_count" t-value="product_count + 1"/>

                            <!-- Create a box for each product, 2x2 grid per page -->
                            <div class="col-6 p-2" style="height: 50vh;">
                                <div style="border: 1px solid #ddd; border-radius: 10px; height: 100%; padding: 15px; background-color: #ffffff; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                    <!-- Product Name -->
                                    <h4 class="text-center" style="color: #333; font-weight: bold; margin-bottom: 15px; border-bottom: 2px solid #4CAF50; padding-bottom: 8px;">
                                        <t t-esc="product.name"/>
                                    </h4>

                                    <div class="row" style="height: 80%;">
                                        <!-- Product Image -->
                                        <div class="col-6 d-flex align-items-center justify-content-center">
                                            <div style="text-align: center;">
                                                <img t-if="product.image_1920" t-att-src="image_data_uri(product.image_1920)" style="max-width: 100%; max-height: 150px; object-fit: contain;"/>
                                                <img t-else="" src="/web/static/img/placeholder.png" style="max-width: 100%; max-height: 150px;"/>
                                            </div>
                                        </div>

                                        <!-- Product Details -->
                                        <div class="col-6">
                                            <div style="margin-bottom: 10px;">
                                                <strong style="color: #4CAF50;">Price:</strong>
                                                <div style="font-size: 18px; font-weight: bold; color: #E91E63;">
                                                    <t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                </div>
                                            </div>

                                            <div style="margin-bottom: 10px;">
                                                <strong style="color: #4CAF50;">Ref:</strong>
                                                <div><t t-esc="product.default_code or '—'"/></div>
                                            </div>

                                            <div>
                                                <strong style="color: #4CAF50;">Description:</strong>
                                                <div style="max-height: 100px; overflow-y: auto; font-size: 12px;">
                                                    <t t-if="product.description_sale" t-esc="product.description_sale"/>
                                                    <t t-elif="product.description" t-esc="product.description"/>
                                                    <t t-else="">No description available</t>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Add page break every 4 products (or as per page_break_after if it's less than 4) -->
                            <t t-if="(docs.page_break_after &lt; 4 and product_count % docs.page_break_after == 0) or
                                     (docs.page_break_after >= 4 and product_count % 4 == 0)">
                                <t t-if="product_count != len(docs.product_ids)">
                                    <div style="page-break-after: always;"/>
                                </t>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>