<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="product_review_view_list" model="ir.ui.view">
        <field name="name">product.review.list</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <list string="Product Reviews">
                <field name="product_id"/>
                <field name="reviewer_name"/>
                <field name="rating"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="product_review_view_form" model="ir.ui.view">
        <field name="name">product.review.form</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <form string="Product Review">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="user_id"/>
                            <field name="rating"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="reviewer_name"/>
                        </group>
                    </group>
                    <group string="Review">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="action_product_review" model="ir.actions.act_window">
        <field name="name">Product Reviews</field>
        <field name="res_model">product.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_review_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No product reviews yet!
            </p>
            <p>
                Reviews will appear here when customers submit them on your website.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_product_review"
        name="Product Reviews"
        parent="website_sale.menu_catalog"
        action="action_product_review"
        sequence="60"/>
</odoo>