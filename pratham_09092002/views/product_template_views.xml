<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add reviews tab in product form view -->
    <record id="product_template_form_view_inherit_reviews" model="ir.ui.view">
        <field name="name">product.template.form.inherit.reviews</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Reviews" name="reviews">
                    <field name="product_review_ids" readonly="1">
                        <list>
                            <field name="reviewer_name"/>
                            <field name="rating"/>
                            <field name="description"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Action method for the button -->
    <record id="product_template_action_view_reviews" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">product.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_id', '=', active_id)]</field>
    </record>
</odoo>
