<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_approval" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_confirm']" position="attributes">
                    <attribute name="invisible">['|', ('state', 'not in', ['draft', 'sent']), '&amp;', ('approval_required', '=', True), ('approval_state', '!=', 'approved')]</attribute>
                </xpath>
                <xpath expr="//button[@name='action_confirm']" position="after">
                    <button name="action_send_for_approval"
                            string="Send for Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft','sent']  or approval_state not in ['to_submit']"/>

                    <button name="action_approve_order"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            groups="sales_team.group_sale_manager"
                            invisible= "approval_state not in ['pending_approval','to_submit']"/>
                </xpath>
                <xpath expr="//header" position="inside">
                    <field name="approval_state" widget="statusbar" statusbar_visible="to_submit,pending_approval,approved"
                        options="{'clickable': '1'}" tracking="True"/>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="approval_required" invisible="state not in ['draft', 'sent']"/>
                    <field name="approver_id" invisible="approval_required == False or approval_state == 'to_submit'"/>
                    <field name="approved_by_id" invisible="approval_state != 'approved'"/>
                    <field name="approved_date" invisible="approval_state  != 'approved'"/>
                </xpath>
            </field>
        </record>
        <!-- Sale Order List View modifications -->
        <record id="view_order_list_inherit_approval" model="ir.ui.view">
            <field name="name">sale.order.list.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_list_upload"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="approval_state" optional="show"/>
                    <field name="approver_id" optional="hide"/>
                </xpath>
            </field>
        </record>
        <!-- Approval Pending Sales Orders Filter -->
        <record id="view_sales_order_filter_inherit_approval" model="ir.ui.view">
            <field name="name">sale.order.list.select.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter string="Pending Approval" name="pending_approval" domain="[('approval_state', '=', 'pending_approval')]"/>
                </xpath>
            </field>
        </record>
        <!-- Menu for Pending Approvals -->
        <record id="action_sale_order_pending_approval" model="ir.actions.act_window">
            <field name="name">Pending Sales Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending_approval': 1}</field>
            <field name="domain">[('approval_state', '=', 'pending_approval')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Sales Orders pending for approval!
                </p>
            </field>
        </record>

        <menuitem id="menu_sale_order_approvals"
                  name="Approvals"
                  parent="sale.sale_menu_root"
                  sequence="5" />

        <menuitem id="menu_sale_order_pending_approval"
                  name="Pending Sales Orders"
                  parent="menu_sale_order_approvals"
                  action="action_sale_order_pending_approval"
                  sequence="1" />
</odoo>
