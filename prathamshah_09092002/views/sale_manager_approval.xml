<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Manager Approval model views -->
    <record id="view_sales_manager_approval_list" model="ir.ui.view">
        <field name="name">sales.manager.approval.list</field>
        <field name="model">sales.manager.approval</field>
        <field name="arch" type="xml">
            <list string="Sales Manager Approvals">
                <field name="sales_manager_id"/>
                <field name="approval_threshold"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>
    <!--Form view-->
    <record id="view_sales_manager_approval_form" model="ir.ui.view">
        <field name="name">sales.manager.approval.form</field>
        <field name="model">sales.manager.approval</field>
        <field name="arch" type="xml">
            <form string="Sales Manager Approval">
                <sheet>
                    <group>
                        <group>
                            <field name="sales_manager_id" />
                            <field name="approval_threshold"/>
                        </group>
                        <group>
                            <field name="currency_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Sales Manager Approval -->
    <record id="action_sales_manager_approval" model="ir.actions.act_window">
        <field name="name">Approval Thresholds</field>
        <field name="res_model">sales.manager.approval</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new approval threshold
            </p>
            <p>
                Configure sales manager approval thresholds for different amounts.
            </p>
        </field>
    </record>

    <!-- Menu for Sales Manager Approval -->
    <menuitem id="menu_sales_manager_approval"
              name="Sales Manager Approvals"
              parent="sale.menu_sale_config"
              action="action_sales_manager_approval"
              sequence="20"/>
</odoo>