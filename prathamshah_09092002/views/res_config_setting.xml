<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Add some field in res config setting-->
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sales.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='variant_options']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="sales_approval_settings">
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Sales Approval Thresholds</span>
                        <div class="text-muted">
                            Configure approval thresholds for sales orders
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="sales_approval_threshold_ids" widget="many2many_tags"/>
                                <button name="%(action_sales_manager_approval)d" icon="fa-arrow-right" type="action" string="Configure Approval Thresholds" class="btn-link"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>