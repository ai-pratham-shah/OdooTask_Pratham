<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_sale_approval" model="mail.template">
            <field name="name">Sales Order: Approval Request</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="email_from">{{object.company_id.email_formatted or ''}}</field>
            <field name="partner_to">{{object.approver_id.partner_id.id}}</field>
            <field name="subject">Sales Order {{object.name}} - Approval Required</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.approver_id.name"/>,
                        <br /><br />
                        A new sales order requires your approval:
                        <br /><br />
                        <p>Order:
                            <t t-out="object.name"/>
                        </p>
                        <br/>
                        <p>Customer:<t t-out="object.partner_id.name"/></p>
                        <br />
                        <p>Total Amount:<t t-out="object.currency_id.symbol"/><t t-out="object.amount_total"/></p>
                        <br />
                        <p>Salesperson:<t t-out="object.user_id.name"/></p>
                        <br /><br />
                        You can review and approve this order by clicking the following link:
                        <br/>
                        <a href="/web#id={{object.id}}&amp;model=sale.order&amp;view_type=form"
                           style="background-color: #1abc9c; padding: 8px 16px; border-radius: 5px; font-size: 13px;">
                            View Order
                        </a>
                        <br /><br />
                        Thank you,
                        <br />
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
        <record id="email_template_sale_approval_reminder" model="mail.template">
            <field name="name">Sales Order: Approval Reminder</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="subject">Reminder: Sales Orders Pending Your Approval</field>
            <field name="email_from">{{object.company_id.email_formatted or ''}}</field>
            <field name="partner_to">{{object.approver_id.partner_id.id}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.approver_id.name"/>,
                        <br /><br />
                        This is a reminder that you have sales orders pending your approval:
                        <br /><br />
                        <t t-out="ctx['order_list'] or ''"/>
                        <br/>
                        Please review these orders at your earliest convenience.
                        <br /><br />
                        <a href="/web#action={{ctx['action_id']}}&amp;model=sale.order&amp;view_type=list"
                           style="background-color: #1abc9c; padding: 8px 16px; border-radius: 5px; font-size: 13px;">
                            View Pending Orders
                        </a>
                        <br /><br />
                        Thank you,
                        <br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>