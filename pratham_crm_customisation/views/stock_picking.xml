<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add job name field in delivery form -->
    <record id="view_stock_picking_form_inherit_job_name" model="ir.ui.view">
        <field name="name">view_stock_picking_form_inherit_job_name</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="job_name" readonly="job_name_readonly == True or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>