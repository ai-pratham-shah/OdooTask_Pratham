<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add job name field in mrp production form -->
    <record id="view_mrp_form_inherit_job_name" model="ir.ui.view">
        <field name="name">sale.mrp.form.inherit.job.name</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="job_name" readonly="job_name_readonly == True or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>