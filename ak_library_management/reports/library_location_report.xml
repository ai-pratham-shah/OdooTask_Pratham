<odoo>
    <!--    Report Template-->
    <template id="library_location_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <xpath expr="//div[@class='oe_structure']" position="inside">
                            <div class="text-center" style="margin-top: 20px;">
                                <h3>Library Report</h3>
                            </div>

                            <t t-foreach="docs" t-as="doc">
                                <p>Library ID #
                                    <strong t-out="doc.id"/>
                                </p>
                                <div class="info-container"
                                     style="display: flex; flex-wrap: wrap; justify-content: space-between; padding: 10px;">
                                    <div class="info-container"
                                         style="display: flex; justify-content: space-between; padding: 10px;">
                                        <!-- Library Name -->
                                        <div class="info-item" style="flex: 1; text-align: left;">
                                            <strong>Library Name:</strong>
                                            <span t-out="doc.name"/>
                                        </div>

                                        <!-- Librarian Name -->
                                        <div class="info-item" style="flex: 1; text-align: left;">
                                            <strong>Librarian Name:</strong>
                                            <span t-out="doc.librarian_id.name or 'N/A'"/>
                                        </div>

                                        <!-- Total Borrowed Books Count -->
                                        <div class="info-item" style="flex: 1; text-align: left;">
                                            <strong>Total Borrowed Books Count:</strong>
                                            <span t-out="doc.borrowed_books_count"/>
                                        </div>

                                        <!-- Location -->
                                        <div class="info-item" style="flex: 1; text-align: left;">
                                            <strong>Location:</strong>
                                            <span t-out="doc.location or 'Unknown'"/>
                                        </div>
                                    </div>
                                </div>

                                <table class="table table-bordered" style="margin-top: 20px;">
                                    <thead>
                                        <tr>
                                            <th>Book</th>
                                            <th>Price</th>
                                            <th>Published Date</th>
                                            <th>Author</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.book_ids" t-as="book">
                                            <tr>
                                                <td>
                                                    <strong t-out="book.default_code or 'No ISBN'"/>
                                                    -
                                                    <strong t-out="book.name or 'Unknown Title'"/>
                                                </td>
                                                <td t-out="book.list_price or '0.00'"/>
                                                <td t-out="book.published_date.strftime('%d/%b/%Y') if book.published_date else 'N/A'"/>
                                                <td t-out="book.author if book.author else 'Unknown'"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <p>Note:
                                <strong t-out="doc.notes"/>
                            </p>
                        </xpath>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>