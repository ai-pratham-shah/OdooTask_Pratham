<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Report Template for library location -->
    <template id="library_location_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h3>
                    <span>Library Name # [ID]: [<strong t-out="doc.name"/>]
                    </span>
                    #
                    <strong t-out="doc.id"/>
                </h3>
                <div class="row">
                    <!-- Current Date -->
                    <div class="col-3">
                        <strong>Date:</strong>
                        <p t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                    </div>
                    <!-- Librarian Name -->
                    <div class="col-3">
                        <strong>Librarian Name:</strong>
                        <p t-field="doc.librarian_id.name"/>
                    </div>
                    <!-- Total Borrowed Books Count -->
                    <div class="col-3">
                        <strong>Total Borrowed Books:</strong>
                        <div t-out="round(float(doc.borrowed_books_count),1)"/>
                    </div>
                    <!-- Location -->
                    <div class="col-3">
                        <strong>Location:</strong>
                        <p t-field="doc.location"/>
                    </div>
                </div>
                <table class="table table-bordered" style="margin-top: 20px;">
                    <thead>
                        <tr>
                            <th style="padding: 8px; color: #FFBF00;">Book</th>
                            <th style="padding: 8px; color: #FFBF00">Price</th>
                            <th style="padding: 8px; color: #FFBF00">Published Date</th>
                            <th style="padding: 8px; color: #FFBF00 ">Author</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.book_ids" t-as="book">
                            <tr>
                                <td style="padding: 10px;">
                                    <strong t-out="book.barcode"/>
                                    <br/>
                                    <strong t-out="book.name or 'Unknown Title'"/>
                                    <br/>
                                    on hand:
                                    <strong t-out="int(book.qty_available)"/>
                                </td>
                                <td t-out="book.list_price or '0.00'"/>
                                <td t-out="book.published_date.strftime('%d/%b/%Y') if book.published_date else 'N/A'"/>
                                <td t-out="book.author if book.author else 'Unknown'"/>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <p>Note:
                    <strong t-out="doc.notes"/>
                </p>
            </div>
        </t>
    </template>

    <!--html container of dynamic report-->
    <template id="library_location_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ak_library_management.library_location_document"/>
            </t>
        </t>
    </template>

    <template id="library_external_layout" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not doc</attribute>
        </xpath>
        <xpath expr="//img" position="attributes">
            <attribute name="style">width:200px;height:600px</attribute>
        </xpath>
        <xpath expr="//img" position="after">
            <div t-if="doc" class="align-items-end justify-content-end">
                <ul class="list-unstyled" name="company_address_list">
                    <li>
                        <span t-field="company.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "email", "phone"], "no_marker": true}'>
                        </span>
                    </li>
                </ul>
            </div>
        </xpath>
        <xpath expr="//div[@t-field='company.report_footer']" position="attributes">
            <attribute name="t-if">not doc</attribute>
        </xpath>
        <xpath expr="//div[@t-field='company.report_footer']" position="after">
            <div id="website_footer" class="flex-grow-1 text-start me-2" t-if="doc">
                <span t-out="company.website"/>
            </div>
        </xpath>
    </template>

    <!--    Report Template for library member -->
    <template id="custom_external_layout_library_member">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <div t-attf-class="header o_company_#{company.id}_layout">
            <div t-if="company" class="text-center">
                <h3>
                    <span t-out="company.partner_id.name"/>
                </h3>
            </div>
        </div>
        <center>
            <div t-attf-class="article o_company_#{company.id}_layout">
                <strong>Member's Details:-</strong>
                <br/>
                <br/>
                <b>Name:</b>
                <t t-out="o.name or ''"/>
                <br/>
                <br/>
                <b>Email:</b>
                <t t-out="o.email or ''"/>
                <br/>
                <br/>
                <b>Phone No:</b>
                <t t-out="o.phone or ''"/>
                <br/>
                <br/>
                <b>Membership Start Date:</b>
                <t t-out="o.membership_date or ''"/>
                <br/>
            </div>
        </center>
        <div t-attf-class="footer o_company_#{company.id}_layout">
            <div t-if="company" class="text-center">
                <span t-out="company.partner_id.website"/>
            </div>
        </div>
    </template>

    <!--html container of custom library member report-->
    <template id="report_library_member">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ak_library_management.custom_external_layout_library_member"/>
            </t>
        </t>
    </template>
</odoo>