<odoo>
    <!--    Report Function in Expense -->
    <record id="action_expense_request_report" model="ir.actions.report">
        <field name="name">Library Report</field>
        <field name="model">library.book.location</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.library_location_report</field>
        <field name="report_file">ak_library_management.library_location_report</field>
        <field name="binding_model_id" ref="model_library_book_location"/>
        <field name="binding_type">report</field>
    </record>

     <!--library member report action-->
    <record id="action_report_library_member" model="ir.actions.report">
        <field name="name">Member Report</field>
        <field name="model">library.member</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ak_library_management.report_library_member</field>
        <field name="report_file">ak_library_management.report_library_member</field>
        <field name="binding_model_id" ref="model_library_member"/>
        <field name="binding_type">report</field>
    </record>
</odoo>