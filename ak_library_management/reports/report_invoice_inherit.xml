<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="external_layout_standard_no_border" inherit_id="web.external_layout_standard">
            <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
                <attribute name="t-attf-class">article o_report_layout_standard o_company_#{company.id}_layout o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}</attribute>
            </xpath>
        </template>
        <template id="invoice_custom_header_inherit" inherit_id="web.external_layout_standard">
            <xpath expr="//div[@name='company_address']" position="replace">
                <div class="row">
                    <div class="col-9" style="text-align: left;">
                        <div class="mb-1">
                            <strong>Invoice Reference:</strong>
                            <span t-field="o.name"/>
                        </div>
                        <div class="mb-1">
                            <strong>Invoice Date:</strong>
                            <span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </div>
                        <div class="mb-1">
                            <strong>Reference Period:</strong>
                            <span t-field="o.invoice_date_due" t-options='{"format": "dd/MM/yyyy"}'/>
                        </div>
                        <div class="mb-1">
                            <strong>Payment Term:</strong>
                            <span t-field="o.invoice_payment_term_id"/>
                        </div>
                    </div>
                    <div class="col-6 text-right align-items-end justify-content-end">
                        <ul class="list-unstyled" name="company_address_list">
                            <li>
                                <strong>
                                    <span t-field="o.partner_id"
                                          t-options='{"widget": "contact", "fields": ["name","address"], "no_marker": True}'>
                                    </span>
                                </strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
                <div class="o_footer_content d-flex justify-content-center pt-2"
                     style="color: darkblue; font-size: 15px; font-weight: bold; border-top: none; margin-top:80px;">
                    <div class="text-center">
                        <span>Nolen, Winker and Partners - 33, rue de Gasperich, L- 5826 Hesperange - VAT LU31980427
                        </span>
                    </div>
                </div>
            </xpath>
        </template>

        <template id="custom_header" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@class='clearfix invoice_main']/div[@class='page mb-4']/t[@t-set='layout_document_title']"
                   position="replace">
                <div>
                    <p style="font-weight: bold; font-size: 20px; margin-bottom: 80px;">INVOICE</p>
                </div>
            </xpath>
        </template>

<!--        <template id="report_table_header_bold" inherit_id="account.report_invoice_document">-->
<!--            <xpath expr="//table[@name='invoice_line_table']" position="before">-->
<!--                <style>-->
<!--                    th {-->
<!--                        font-weight: bold;-->
<!--                    }-->
<!--                </style>-->
<!--            </xpath>-->
<!--        </template>-->

        <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@name='address_same_as_shipping']" position="replace">
                <div/>
            </xpath>

             <xpath expr="//table[@name='invoice_line_table']" position="before">
                <style>
                    th {
                        font-weight: bold;
                    }
                </style>
            </xpath>

            <xpath expr="//div[@id='informations']" position="replace">
                <div/>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']" position="replace">
                <table class="o_has_total_table table o_main_table table-borderless"
                       style="width: 100%; border: none; text-align: left;">
                    <thead>
                        <tr>
                            <th style="text-align: left; font-weight: bold;">Description</th>
                            <th style="text-align: right; font-weight: bold;">Quantity</th>
                            <th style="text-align: right; font-weight: bold;">Unit Price</th>
                            <th style="text-align: right; font-weight: bold;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids" t-as="line">
                            <tr>
                                <td style="text-align: left;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-field="line.quantity"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-field="line.price_unit"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-field="line.price_subtotal"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </xpath>

            <xpath expr="//div[@id='right-elements']" position="attributes">
                <attribute name="t-attf-class"/>
            </xpath>

            <xpath expr="//t[@t-call='account.document_tax_totals_company_currency_template']" position="attributes">
                <attribute name="t-if">not o</attribute>
            </xpath>

            <xpath expr="//div[@id='payment_term']" position="attributes">
                <attribute name="style">
                    margin-top: 100px;
                </attribute>
            </xpath>

<!--            <xpath expr="//tr[@class='o_subtotal']" position="attributes">-->
<!--                <attribute name="style">-->
<!--                    font-weight : bold;-->
<!--                </attribute>-->
<!--            </xpath>-->
<!--            -->
            <xpath expr="//span[@id='payment_terms_note_id']" position="attributes">
                <attribute name="t-if">not o</attribute>
            </xpath>
        </template>
        <template id="document_tax_totals_template_inherit" inherit_id="account.document_tax_totals_template">
            <xpath expr="//tr[@class='o_subtotal']/td[1]" position="attributes">
                <attribute name="style">
                    font-weight: bold;
                </attribute>
            </xpath>
        </template>
    </data>
</odoo>
