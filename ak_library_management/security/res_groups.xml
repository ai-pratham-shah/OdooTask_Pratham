<!--        <field name="groups" eval="[(4, ref('group_library_assistant')), (4, ref('group_library_worker'))]"/>-->
<!--        <field name="perm_unlink" eval="0"/>-->
<!--    </record>-->
    <record id="record_rule_library_worker_unlink_borrowed" model="ir.rule">
        <field name="name">No Deleting Borrowed Books</field>
        <field name="model_id" ref="ak_library_management.model_product_template"/>
        <field name="domain_force">[('status', '!=', 'borrowed')]</field>
        <field name="groups" eval="[(4, ref('ak_library_management.group_library_worker')), (4, ref('ak_library_management.group_library_assistant'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>