<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_stock_warehouse">
        <field name="name">Stock Warehouse</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_library_worker" model="res.groups">
        <field name="name">Library Worker</field>
        <field name="category_id" ref="module_category_stock_warehouse"/>
    </record>

    <record id="group_library_assistant" model="res.groups">
        <field name="name">Library Assistant</field>
        <field name="category_id" ref="module_category_stock_warehouse"/>
        <field name="implied_ids" eval="[(4, ref('group_library_worker'))]"/>
    </record>

    <record id="group_library_admin" model="res.groups">
        <field name="name">Library Admin</field>
        <field name="category_id" ref="module_category_stock_warehouse"/>
        <field name="implied_ids" eval="[(4, ref('group_library_assistant'))]"/>
    </record>

     <!-- Record Rule: Only Library Admin can modify both Library Assistant and Worker fields -->
    <record id="rule_admin_modify_warehouse" model="ir.rule">
        <field name="name">Library Admin Can Modify Warehouse Roles</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_admin'))]"/>
        <field name="perm_write" eval="1"/>
    </record>

     <!-- Library Assistant Can Modify Worker Field Only -->
    <record id="rule_assistant_modify_worker" model="ir.rule">
        <field name="name">Library Assistant Can Modify Workers Only</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_assistant'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

     <record id="library_worker_access_rule" model="ir.rule">
        <field name="name">Library Worker Access</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_library_worker'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>