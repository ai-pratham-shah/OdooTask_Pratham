<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Schedule action for book return reminder-->
        <record id="ir_cron_book_return_reminder" model="ir.cron">
            <field name="name">Book Return Reminder</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="code">model.send_book_return_reminders()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <!-- Action server for mark book as returned-->
        <record id="action_mark_books_as_returned" model="ir.actions.server">
            <field name="name">Mark Books as Returned</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="binding_model_id" ref="model_borrow_transaction_history"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code"><![CDATA[
                records.mark_books_as_returned()
            ]]></field>
        </record>
        <!-- Action server for prevent over borrowing -->
        <record id="action_prevent_over_borrowing" model="ir.actions.server">
            <field name="name">Prevent Over-Borrowing</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
                record.check_overdue_books_action()
            ]]></field>
        </record>
        <!-- Automation rule to prevent over borrowing and link above server action-->
        <record id="automation_rule_prevent_over_borrowing" model="base.automation">
            <field name="name">Prevent Over-Borrowing</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="trigger">on_create_or_write</field>
            <field name="action_server_ids" eval="[(4, ref('action_prevent_over_borrowing'))]"/>
        </record>
        <!-- Cron Job to Send Overdue Book Reminders Weekly -->
        <record id="ir_cron_send_overdue_reminders" model="ir.cron">
            <field name="name">Send Overdue Book Reminders</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="state">code</field>
            <field name="code">model.send_overdue_book_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
        </record>
    </data>
</odoo>
