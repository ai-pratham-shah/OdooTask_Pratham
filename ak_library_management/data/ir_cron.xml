<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_book_return_reminder" model="ir.cron">
        <field name="name">Book Return Reminder</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="code">model.send_book_return_reminders()</field>
<!--        <field name="user_id" ref="base.user_root"/>-->
        <field name="state">code</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
<!--        <field name="nextcall" eval="(context_today() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>-->

    </record>
    <record id="ir_actions_borrow_transaction_history" model="ir.actions.server">
        <field name="name">Change Book status</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="binding_model_id" ref="model_borrow_transaction_history"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            for rec in records:
                for book in rec.books_ids:
                    env['bus.bus']._sendone(rec.customer_id, 'simple_notification', {
                    'type': 'warning',
                    'message': f"{rec.customer_id.name} your return book has been recorded.",
                    })
                    book.mark_as_returned()
        </field>
    </record>

</odoo>
