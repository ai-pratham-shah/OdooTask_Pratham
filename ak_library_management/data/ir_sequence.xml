<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- set the sequence for reference field -->
    <record id="seq_product_reference" model="ir.sequence">
        <field name="name">Book Reference</field>
        <field name="code">product.template</field>
        <field name="prefix">BOOK-%(year)s-</field>
        <field name="padding">4</field>
    </record>
    <!-- set the sequence in the member form -->
    <record id="seq_book_member_reference" model="ir.sequence">
        <field name="name">Book member Reference</field>
        <field name="code">library.member</field>
        <field name="prefix">MEM-%(year)s-%(month)s-</field>
        <field name="padding">4</field>
    </record>
</odoo>