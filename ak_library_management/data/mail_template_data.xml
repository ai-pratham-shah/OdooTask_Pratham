<odoo>
    <data>
        <!-- Email Template for Overdue Book Reminder -->
        <record id="book_return_reminder_email_template" model="mail.template">
            <field name="name">Overdue Book Reminder</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="email_from">{{ (user.email) }}</field>
            <field name="partner_to">{{ object.customer_id.id }}</field>
            <field name="subject">Reminder: Please Return Your Overdue Book</field>
            <field name="description">Reminder for customers about overdue books</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-if="object.customer_id.parent_id">
                            <t t-out="object.customer_id.name or ''"/> (<t t-out="object.customer_id.parent_id.name or ''"/>),
                        </t>
                        <t t-else="">
                            <t t-out="object.customer_id.name or ''"/>,
                        </t>
                        <br /><br />
                        This is a reminder that the following book(s) you borrowed from the library are overdue:
                        <ul>
                            <t t-foreach="object.books_ids" t-as="book">
                                <li><t t-out="book.name"/></li>
                            </t>
                        </ul>
                        <p>Borrowed on: <t t-out="object.borrow_start_date"/></p>
                        <p>Due Date: <t t-out="object.borrow_end_date"/></p>
                        <p>We kindly ask you to return the book(s) as soon as possible. Failure to do so may result in late fees.</p>
                        <br />
                        <p>Thank you</p>
                    </p>
                </div>
            </field>
        </record>
        <!-- Email Template for membership renewal Reminder -->
        <record id="library_membership_renewal_reminder_email_template" model="mail.template">
            <field name="name">Membership renewal</field>
            <field name="model_id" ref="model_library_member"/>
            <field name="email_from">{{ user.company_id.email }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Reminder: Membership renewal</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.name"/>,
                        <br/><br/>
                        This is a reminder that your library membership is about to expire
                        Please renew your membership to continue enjoying our services.
                        <br /><br />
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('ak_library_management.action_report_library_member'))]"/>
        </record>
    </data>
</odoo>
