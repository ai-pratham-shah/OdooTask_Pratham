<odoo>
    <!-- Search View for Borrow Transaction History -->
    <record id="view_borrow_transaction_history_search" model="ir.ui.view">
        <field name="name">borrow.transaction.history.search</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <field name="borrow_start_date"/>
                <field name="borrow_end_date"/>
                <filter string="Member" name="filter_member" domain="[('customer_id.is_member', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- List View for Borrow Transaction History -->
    <record id="view_borrow_transaction_history_list" model="ir.ui.view">
        <field name="name">borrow.transaction.history.list</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="borrow_start_date"/>
                <field name="borrow_end_date"/>
                <field name="deposit_amount"/>
            </list>
        </field>
    </record>

    <!-- Form View for Borrow Transaction History -->
    <record id="view_borrow_transaction_history_form" model="ir.ui.view">
        <field name="name">borrow.transaction.history.form</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <form string="Borrow Transaction">
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="books" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="borrow_start_date"/>
                        <field name="borrow_end_date"/>
                        <field name="deposit_amount" invisible="is_member == True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Borrow Transaction History -->
    <record id="action_borrow_transaction_history" model="ir.actions.act_window">
        <field name="name">Borrow Transactions</field>
        <field name="res_model">borrow.transaction.history</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_borrow_transaction_history_list"/>
    </record>

    <!-- Menu for Borrow Transaction History -->
    <menuitem id="menu_borrow_transaction_history" name="Borrow Transactions"
              parent="menu_library_management" action="action_borrow_transaction_history"/>
</odoo>


