<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Modify Product Template Form View -->
    <record id="product_template_form_view_vendor_inherit" model="ir.ui.view">
        <field name="name">product.template.form.vendor.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group name="variant_vendor_group">
                    <field name="vendor_on_variants" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>

     <!-- Add constraint to Supplier Info Form View -->
    <record id="product_supplierinfo_form_view_inherit" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.inherit</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <!-- Modify domain for product_id field to consider vendor_on_variants -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('product_tmpl_id', '=', product_tmpl_id), ('product_tmpl_id.vendor_on_variants', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>