<odoo>
    <record id="borrow_books_action" model="ir.ui.view">
        <field name="name">borrow.books.wizard.form</field>
        <field name="model">borrow.books.wizard</field>
        <field name="arch" type="xml">
            <form string="Borrow Books">
                <group>
                    <field name="customer_id"/>
                    <field name="from_datetime"/>
                    <field name="end_datetime"/>
                    <field name="book_ids" widget="many2many_tags"/>
                    <field name="deposit_amount" invisible="is_member == True"/>
                </group>
                <footer>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
