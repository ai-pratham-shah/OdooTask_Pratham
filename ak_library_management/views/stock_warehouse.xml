<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_warehouse_form_view_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.form.view</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="library_assistant" groups="ak_library_management.group_library_admin"/>
                <field name="workers_ids" widget="many2many_tags" groups="ak_library_management.group_library_admin,ak_library_management.group_library_assistant"/>
            </xpath>
        </field>
    </record>
</odoo>