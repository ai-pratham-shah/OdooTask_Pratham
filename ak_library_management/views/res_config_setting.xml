<odoo>
    <record id="view_library_config_settings" model="ir.ui.view">
        <field name="name">library.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='module_account_inter_company_rules']" position="after">
                <group>
                    <field name="borrowing_limit"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
