<odoo>
<!--    sale order form for handle button related operations-->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">state != 'draft' or approval_needed</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'sent', 'sale'] or not id or locked or approval_needed</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="before">
                <button name="action_approve" type="object" string="Approve" class="btn-primary"
                        invisible="not approval_needed"/>
                <button name="action_reject" type="object" string="Reject" class="btn-primary"
                        invisible="not approval_needed"/>
            </xpath>
        </field>
    </record>
</odoo>

