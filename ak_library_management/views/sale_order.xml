<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add the 'Approve' and 'Reject' buttons -->
            <xpath expr="//button[@name='action_confirm']" position="before">
                <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/>
<!--                <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'draft'"/>-->
            </xpath>
        </field>
    </record>
</odoo>