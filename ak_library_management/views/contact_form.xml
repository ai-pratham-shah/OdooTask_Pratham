<odoo>
    <template id="contact_form" name="Contact Form">
        <t t-call="website.layout">
            <div class="container mt32">
                <h2>Contact Form</h2>
                <form method="post" action="#" class="contact_form">
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" class="form-control" id="name" name="name"
                               t-att-value="contact.name"/>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" class="form-control" id="email" name="email"
                               t-att-value="contact.email"/>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone</label>
                        <input type="text" class="form-control" id="phone" name="phone"
                               t-att-value="contact.phone"/>
                    </div>
                    <!-- Add other fields here as needed -->
                    <a href="/contacts" class="btn btn-secondary">Back</a>
                </form>
            </div>
        </t>
    </template>
</odoo>