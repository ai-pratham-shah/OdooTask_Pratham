<odoo>
    <!-- form View for inherited product template -->
    <record id="view_product_template_inherit_form" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mark_borrowed" string="Mark as Borrowed" type="object"/>
<!--                /> #invisible="status != 'available'"-->
                <button name="action_mark_available" string="Mark as Available" type="object"
                invisible="status != 'borrowed'"/>
                <button name="action_borrow_books" string="Borrow Book" type="object"/>
                <field name="status" widget="statusbar" statusbar_visible="available,borrowed,unavailable"
                        options="{'clickable': '1'}" tracking="True"/>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                 <attribute name="readonly">sale_ok == True</attribute>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="after">
                    <page string="Book Details">
                        <group name="col2">
                             <group>
                                <field name="is_library_book" required="sale_ok == True"/>
                                <field name="author" required="sale_ok == True"/>
                                <field name="publisher" required="sale_ok == True"/>
                             </group>
                             <group>
                                 <field name="edition" required="sale_ok == True"/>
                                 <field name="published_date" required="sale_ok == True"/>
                                 <field name="pages" required="sale_ok == True"/>
                                 <field name="available" required="sale_ok == True"/>
                                 <field name="status" required="sale_ok == True"/>
                             </group>
                         </group>
                    </page>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="string">Isbn</attribute>
            </xpath>
            <xpath expr="//field[@name='publisher']" position="after">
                <field name="barcode"  position="move"/>
            </xpath>
        </field>
    </record>
    <!-- Submenu for Library management -->
    <menuitem id="menu_product_template" name="Books" parent="menu_library_management" action="product.product_template_action"/>
</odoo>




