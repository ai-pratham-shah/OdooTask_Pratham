     <template id="contacts_page" name="Contacts Page">
        <t t-call="website.layout">
            <div class="container">
                <h2>Contacts</h2>
                <div class="row">
                    <t t-foreach="contacts" t-as="contact">
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-att-href="'/contact/%s' % contact.slug">
                                            <t t-esc="contact.name"/>
                                        </a>
                                    </h5>
                                    <p class="card-text"><t t-esc="contact.email or 'No Email'"/></p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="contact_detail" name="Contact Detail Page">
        <t t-call="website.layout">
            <div class="container">
                <h2><t t-esc="contact.name"/></h2>
                <form>
                    <div class="form-group">
                        <label>Email:</label>
                        <input type="text" class="form-control" t-att-value="contact.email or ''"/>
                    </div>
                    <div class="form-group">
                        <label>Phone:</label>
                        <input type="text" class="form-control" t-att-value="contact.phone or ''"/>
                    </div>
                    <a href="/contacts" class="btn btn-secondary">Back</a>
                </form>
            </div>
        </t>
    </template>


</odoo>