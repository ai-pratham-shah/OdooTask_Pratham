<odoo>
    <record id="view_warning_wizard_form" model="ir.ui.view">
        <field name="name">borrow.books.warning.wizard.form</field>
        <field name="model">borrow.books.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Warning">
                <sheet>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Continue" class="btn-default" special="save"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
