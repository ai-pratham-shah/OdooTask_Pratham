<odoo>
<!--    To show dynamic message to the user from wizard from-->
    <record id="view_sale_order_approval_wizard" model="ir.ui.view">
        <field name="name">sale.order.approval.wizard.form</field>
        <field name="model">sale.order.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Sale Order Approval">
                <group>
                    <field name="message" readonly="1"/>
                    <footer>
                        <button special="cancel" string="Close" class="btn-secondary"/>
                    </footer>
                </group>
            </form>
        </field>
    </record>
</odoo>