<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.onboarding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="User Onboarding" data-string="User Onboarding" name="pratham_frontend_document2" icon="fa fa-user">
                    <block title="User Onboarding Settings" name="user_onboarding_setting_container">
                        <setting id="user_onboarding_enable">
                            <field name="enable_user_onboarding"/>
                            <div class="text-muted">
                                If enabled, new users will go through an onboarding process on first login
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>